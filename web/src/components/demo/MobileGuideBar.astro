---
import type { Copy } from '../../i18n/types';
import MenuIcon from '../icons/MenuIcon.astro';
import ProgressMeter from './ProgressMeter.astro';

interface Props {
  demo: Copy['demo'];
}

const { demo } = Astro.props;
---

<button
  type="button"
  data-sheet-open
  aria-haspopup="dialog"
  class="grid w-full flex-none cursor-pointer gap-2.5 border-b border-paper-line bg-paper-raised px-4 py-3 text-left sm:hidden"
>
  <span class="flex items-center gap-3">
    <span class="grid size-11 flex-none place-content-center rounded-[10px] border border-[#cfc6c8] bg-paper">
      <MenuIcon />
    </span>
    <span class="min-w-0 flex-1 truncate font-semibold">{demo.guideName}</span>
    <span class="font-mono text-[13px] font-semibold text-paper-muted" data-progress-count>
      0 / {demo.steps.length}
    </span>
  </span>
  <ProgressMeter />
</button>
