---
import type { Copy, GuideStep } from '../../i18n/types';
import AgentText from './AgentText.astro';
import CommandBox from './CommandBox.astro';
import ScopeQuestion from './ScopeQuestion.astro';

interface Props {
  step: GuideStep;
  index: number;
  copy: Copy;
}

const { step, index, copy } = Astro.props;
const { demo } = copy;
const label = 'font-mono text-[11px] font-semibold tracking-widest uppercase';
---

<article
  data-step={index}
  hidden={index !== 0}
  class="grid grid-cols-[minmax(0,1fr)] content-start gap-4.5"
>
  <div class="flex items-baseline gap-3">
    <span class:list={[label, 'text-[#c10f18]']}>
      {demo.stepWord} {index + 1}
    </span>
    <span class="font-mono text-xs text-paper-muted">{step.time}</span>
  </div>
  <h3 class="text-[clamp(24px,5vw,30px)] leading-tight font-bold">{step.title}</h3>
  <div class="flex flex-wrap items-center gap-2">
    <b class:list={[label, 'text-paper-muted']}>{demo.where}</b>
    {step.where.map((place) => (
      <span class="rounded border border-paper-line bg-paper-raised px-2 py-1 font-mono text-[13px]">
        <AgentText text={place} />
      </span>
    ))}
  </div>
  {step.scope && <ScopeQuestion scope={step.scope} round={copy.agentDemo.round} />}
  <CommandBox
    id={`demo-step-${index}`}
    kind={step.kind}
    text={step.text}
    idle={copy.copy.idle}
    done={copy.copy.done}
  />
  <div class="grid gap-1.5 rounded-lg border border-ok-line bg-ok-soft px-4 py-3.5">
    <span class:list={[label, 'text-ok']}>✓ {demo.see}</span>
    <span>{step.see}</span>
  </div>
  <details class="rounded-lg border border-paper-line bg-paper-raised px-4 py-3">
    <summary class="cursor-pointer font-semibold">{demo.fail}</summary>
    <p class="pt-2">
      <b>{step.failSymptom}</b> → {step.failAction}
    </p>
  </details>
</article>
