---
import { getCopy } from '../i18n';
import type { Lang } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideDemo from './demo/GuideDemo.astro';
import Hero from './hero/Hero.astro';
import SiteFooter from './layout/SiteFooter.astro';
import SiteHeader from './layout/SiteHeader.astro';
import Tips from './tips/Tips.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang);
---

<BaseLayout
  lang={lang}
  title={copy.meta.title}
  description={copy.meta.description}
  imageAlt={copy.meta.imageAlt}
>
  <div id="top" class="grid-backdrop bg-ink">
    <SiteHeader lang={lang} copy={copy} />
  </div>
  <main>
    <Hero copy={copy} />
    <GuideDemo copy={copy} />
    <Tips tips={copy.tips} />
  </main>
  <SiteFooter copy={copy} />
</BaseLayout>
