  <rect x="7" y="7" width="34" height="34" fill="currentColor"></rect>
  <path
    d="M16 24.5l5.5 5.5 11-12"
    class="stroke-ink"
    stroke-width="3.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
