---
import type { Copy } from '../../i18n/types';
import { GRILL_ME_URL, MAKERLAB_URL, REPO_URL } from '../../data/agents';
import GitHubIcon from '../icons/GitHubIcon.astro';
import MakerLabLogo from '../icons/MakerLabLogo.astro';
import Container from '../ui/Container.astro';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const link = 'text-[#d8d2d3] hover:text-snow';
---

<footer class="border-t border-[#1e1b1b]">
  <Container class="flex flex-col items-center gap-5 py-9 text-center font-mono text-[13px] text-ink-faint sm:flex-row sm:justify-between sm:gap-4 sm:py-8 sm:text-left">
    <span class="inline-flex items-center gap-3.5">
      <a href={MAKERLAB_URL} target="_blank" rel="noopener" class="leading-none">
        <MakerLabLogo />
      </a>
      <a href={REPO_URL} target="_blank" rel="noopener" aria-label="GitHub" class={link}>
        <GitHubIcon />
      </a>
      <span aria-hidden="true">·</span>
      <span>{copy.footer.license}</span>
    </span>
    <span>
      {copy.footer.inspired}
      <a
        href={GRILL_ME_URL}
        target="_blank"
        rel="noopener"
        class:list={[link, 'ml-[1ch] underline underline-offset-4']}
      >
        grill-me ↗
      </a>
    </span>
  </Container>
</footer>
