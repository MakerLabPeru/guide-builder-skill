---
import type { Lang } from '../../i18n/types';
import { REPO_URL } from '../../data/agents';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  imageAlt: string;
}

const LOCALES: Record<Lang, string> = { es: 'es_PE', en: 'en_US' };

const { lang, title, description, imageAlt } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const absolute = (path: string): string => new URL(`${base}${path}`, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const image = absolute(`/og-${lang}.png`);
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'guide-builder',
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Claude Code, Codex, OpenCode',
  license: 'https://opensource.org/licenses/MIT',
  url: pageUrl,
  codeRepository: REPO_URL,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: {
    '@type': 'Organization',
    name: 'MakerLab Perú',
    url: 'https://www.makerlabperu.org/',
  },
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={pageUrl} />
<link rel="alternate" hreflang="es" href={absolute('/')} />
<link rel="alternate" hreflang="en" href={absolute('/en/')} />
<link rel="alternate" hreflang="x-default" href={absolute('/')} />
<link rel="sitemap" href={absolute('/sitemap.xml')} />
<link rel="icon" type="image/svg+xml" href={absolute('/favicon.svg')} />
<link rel="apple-touch-icon" href={absolute('/apple-touch-icon.png')} />
<meta name="theme-color" content="#070707" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="guide-builder" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={pageUrl} />
<meta property="og:locale" content={LOCALES[lang]} />
<meta property="og:locale:alternate" content={LOCALES[otherLang]} />
<meta property="og:image" content={image} />
<meta property="og:image:secure_url" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
