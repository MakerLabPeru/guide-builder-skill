---
import type { Tip } from '../../i18n/types';

interface Props {
  tip: Tip;
  number: number;
}

const { tip, number } = Astro.props;
const panelId = `tip-${number}`;
---

<div
  data-accordion-item
  data-open="false"
  class="group rounded-xl border border-ink-line bg-[#141112] transition-[background,border-color,box-shadow] duration-300 data-[open=true]:border-brand data-[open=true]:bg-[#1a1616] data-[open=true]:shadow-[0_18px_40px_-24px_rgba(225,18,27,.55)]"
>
  <button
    type="button"
    aria-expanded="false"
    aria-controls={panelId}
    class="flex min-h-[68px] w-full cursor-pointer items-center gap-4 px-5.5 text-left text-lg font-semibold"
  >
    <span class="font-mono text-[13px] text-brand-soft">{String(number).padStart(2, '0')}</span>
    <span class="flex-1">{tip.title}</span>
    <span
      aria-hidden="true"
      class="grid size-[30px] place-content-center rounded-full bg-[#221e1e] text-ink-muted transition duration-300 group-data-[open=true]:rotate-45 group-data-[open=true]:bg-brand group-data-[open=true]:text-white"
    >
      +
    </span>
  </button>
  <div
    id={panelId}
    class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-400 ease-[cubic-bezier(.2,.8,.2,1)] group-data-[open=true]:grid-rows-[1fr]"
  >
    <div class="min-h-0 overflow-hidden">
      <p class="-translate-y-1.5 pr-5.5 pb-5.5 pl-[51px] text-base leading-relaxed text-ink-muted opacity-0 transition duration-300 group-data-[open=true]:translate-y-0 group-data-[open=true]:opacity-100 group-data-[open=true]:delay-100">
        {tip.text}
      </p>
    </div>
  </div>
</div>
